# ─────────────────────────────────────────────────────────────
# 소셜 로그인 설정
#
# 이 파일을 `.env.local`로 복사한 뒤 값을 채우세요.
# 값을 비워 두면 해당 제공자는 "목업 모드"로 동작합니다.
# (실제 인가 서버로 나가지 않고 리다이렉트 흐름만 재현합니다.)
#
# ⚠️ Vite의 VITE_ 접두사 변수는 번들에 그대로 포함되어 브라우저에 노출됩니다.
#    client secret 계열 값은 절대 여기에 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# 인가 서버가 되돌려 보낼 주소입니다. 각 개발자 콘솔에 등록한 값과 정확히 같아야 합니다.
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > REST API 키
VITE_KAKAO_CLIENT_ID=

# 네이버 개발자센터 > 애플리케이션 > Client ID
VITE_NAVER_CLIENT_ID=

# Google Cloud Console > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
VITE_GOOGLE_CLIENT_ID=

# Apple Developer > Certificates, Identifiers & Profiles > Services ID
# (App ID가 아니라 Services ID입니다. 예: com.kindy.web)
VITE_APPLE_CLIENT_ID=

# 백엔드가 준비되면 인가 코드를 넘길 API 주소입니다.
# src/app/auth/oauth.ts 의 exchangeCodeForSession()에서 사용합니다.
VITE_API_BASE_URL=http://localhost:8080/api
